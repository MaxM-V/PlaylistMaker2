<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"

    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorOnSecondary"
    tools:context=".MediaPlayer">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/leftBorderMediaPlayer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_begin="16dp" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/rightBorderMediaPlayer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_end="16dp" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/topBorderMediaPlayer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_begin="82dp" />

    <ImageButton
        android:id="@+id/arrowBackPlayer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"

        android:backgroundTint="?attr/colorOnSecondary"
        android:contentDescription="drawable arrow back"
        android:src="@drawable/arrowb24x24"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/imageAlbume"
        android:layout_width="0dp"
        android:layout_height="312dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:scaleType="centerCrop"
        android:src="@drawable/placeholder"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="@+id/rightBorderMediaPlayer"
        app:layout_constraintStart_toStartOf="@+id/leftBorderMediaPlayer"
        app:layout_constraintTop_toBottomOf="@id/topBorderMediaPlayer" />

    <TextView
        android:id="@+id/trackTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_marginTop="24dp"
        android:gravity="start"
        android:text="Yesterday (Remastered 2009)"
        android:textColor="?attr/colorSecondaryVariant"
        android:textSize="22sp"
        app:layout_constraintStart_toStartOf="@id/leftBorderMediaPlayer"
        app:layout_constraintTop_toBottomOf="@id/imageAlbume" />

    <TextView
        android:id="@+id/groupName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="12dp"
        android:gravity="start"
        android:text="The Beatles"
        android:textColor="?attr/colorSecondaryVariant"
        android:textSize="12sp"
        app:layout_constraintStart_toStartOf="@id/leftBorderMediaPlayer"
        app:layout_constraintTop_toBottomOf="@id/trackTitle" />

    <ImageButton
        android:id="@+id/addTracklist"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginStart="8dp"
        android:contentDescription="add"
        android:src="@drawable/add"
        android:backgroundTint="?attr/colorOnSecondary"
        app:layout_constraintBottom_toBottomOf="@id/playAndPause"
        app:layout_constraintEnd_toStartOf="@id/playAndPause"
        app:layout_constraintHorizontal_chainStyle="spread_inside"
        app:layout_constraintStart_toStartOf="@id/leftBorderMediaPlayer"
        app:layout_constraintTop_toBottomOf="@id/groupName"

        />

    <ImageButton
        android:id="@+id/playAndPause"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginTop="30dp"
        android:backgroundTint="?attr/colorOnSecondary"
        android:contentDescription="play"
        android:src="@drawable/play"
        app:layout_constraintBottom_toBottomOf="@id/addTracklist"
        app:layout_constraintEnd_toStartOf="@id/like"
        app:layout_constraintStart_toEndOf="@id/addTracklist"
        app:layout_constraintTop_toBottomOf="@id/groupName" />

    <ImageButton
        android:id="@+id/like"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:contentDescription="like"
        android:layout_marginEnd="8dp"
        android:src="@drawable/nolike"
        android:backgroundTint="?attr/colorOnSecondary"
        app:layout_constraintEnd_toEndOf="@id/rightBorderMediaPlayer"
        app:layout_constraintStart_toEndOf="@id/playAndPause"
        app:layout_constraintTop_toBottomOf="@id/groupName"
        app:layout_constraintBottom_toBottomOf="@id/playAndPause"

        />

    <TextView
        android:id="@+id/currentTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0:29"
        android:textSize="12sp"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/playAndPause"
        app:layout_constraintEnd_toStartOf="@id/playAndPause"
        app:layout_constraintStart_toEndOf="@id/playAndPause"
        />

    <TextView
        android:id="@+id/timeLong"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
android:text="Длительность"
        android:textColor="@color/Grey"
        android:layout_marginTop="59dp"
        app:layout_constraintStart_toEndOf="@id/leftBorderMediaPlayer"
        app:layout_constraintEnd_toEndOf="@id/rightBorderMediaPlayer"
        app:layout_constraintTop_toBottomOf="@id/playAndPause"
        android:textSize="12sp"

        />
    <TextView
        android:id="@+id/timeAll"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="5:35"
     android:gravity="end"
        android:textColor="?attr/colorSecondaryVariant"
        app:layout_constraintStart_toEndOf="@id/leftBorderMediaPlayer"
        app:layout_constraintEnd_toEndOf="@id/rightBorderMediaPlayer"
        app:layout_constraintTop_toTopOf="@id/timeLong"
        android:textSize="12sp"
        />


    <TextView
        android:id="@+id/albume"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Альбом"
        android:textColor="@color/Grey"
        android:layout_marginTop="16dp"
        app:layout_constraintStart_toEndOf="@id/leftBorderMediaPlayer"
        app:layout_constraintEnd_toEndOf="@id/rightBorderMediaPlayer"
        app:layout_constraintTop_toBottomOf="@id/timeLong"
        android:textSize="12sp"

        />




    <TextView
        android:id="@+id/nameAlbume"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Yesterday (Remastered 2009)"
        android:gravity="end"
        android:maxLines="1"
        android:ellipsize="end"
        android:scrollHorizontally="false"
        android:textColor="?attr/colorSecondaryVariant"
        app:layout_constraintStart_toEndOf="@id/leftBorderMediaPlayer"
        app:layout_constraintEnd_toEndOf="@id/rightBorderMediaPlayer"
        app:layout_constraintTop_toTopOf="@id/albume"
        android:textSize="12sp"
        />

    <TextView
        android:id="@+id/yearCreate"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Год"
        android:textColor="@color/Grey"
        android:layout_marginTop="16dp"
        app:layout_constraintStart_toEndOf="@id/leftBorderMediaPlayer"
        app:layout_constraintEnd_toEndOf="@id/rightBorderMediaPlayer"
        app:layout_constraintTop_toBottomOf="@id/nameAlbume"
        android:textSize="12sp"
        />

    <TextView
        android:id="@+id/yearNumber"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="1965"
        android:textColor="?attr/colorSecondaryVariant"
        android:gravity="end"
        app:layout_constraintStart_toEndOf="@id/leftBorderMediaPlayer"
        app:layout_constraintEnd_toEndOf="@id/rightBorderMediaPlayer"
        app:layout_constraintTop_toTopOf="@id/yearCreate"
        android:textSize="12sp"
        />
    <TextView
        android:id="@+id/styleMusic"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Жанр"
        android:textColor="@color/Grey"
        android:layout_marginTop="16dp"
        app:layout_constraintStart_toEndOf="@id/leftBorderMediaPlayer"
        app:layout_constraintEnd_toEndOf="@id/rightBorderMediaPlayer"
        app:layout_constraintTop_toBottomOf="@id/yearCreate"
        android:textSize="12sp"
        />

    <TextView
        android:id="@+id/styleCurrency"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Rock"
        android:textColor="?attr/colorSecondaryVariant"
        android:gravity="end"
        app:layout_constraintStart_toEndOf="@id/leftBorderMediaPlayer"
        app:layout_constraintEnd_toEndOf="@id/rightBorderMediaPlayer"
        app:layout_constraintTop_toTopOf="@id/styleMusic"
        android:textSize="12sp"
        />
    <TextView
        android:id="@+id/countryCreate"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Страна"
        android:textColor="@color/Grey"
        android:layout_marginTop="16dp"
        app:layout_constraintStart_toEndOf="@id/leftBorderMediaPlayer"
        app:layout_constraintEnd_toEndOf="@id/rightBorderMediaPlayer"
        app:layout_constraintTop_toBottomOf="@id/styleMusic"
        android:textSize="12sp"
        />

    <TextView
        android:id="@+id/countryCurrency"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Великобритания"
        android:gravity="end"
        android:textColor="?attr/colorSecondaryVariant"
        app:layout_constraintStart_toEndOf="@id/leftBorderMediaPlayer"
        app:layout_constraintEnd_toEndOf="@id/rightBorderMediaPlayer"
        app:layout_constraintTop_toTopOf="@id/countryCreate"
        android:textSize="12sp"
        />

</androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>